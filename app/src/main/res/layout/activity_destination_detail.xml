<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="←  ALL DESTINATIONS"
            android:textColor="@color/forest_green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back to all destinations" />

        <ImageView
            android:id="@+id/detailImage"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerCrop"
            android:contentDescription="Selected destination photograph"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/detailCountry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ITALY"
            android:textColor="@color/sage"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_marginTop="26dp" />

        <TextView
            android:id="@+id/detailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cinque Terre"
            android:textColor="@color/forest_green"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="44dp"
            android:layout_height="2dp"
            android:background="@color/sage"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/detailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Coastal villages · Mediterranean"
            android:textColor="@color/muted_text"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SOMEWHERE DIFFERENT. SOMETHING MEMORABLE."
            android:textColor="@color/sage"
            android:textSize="9sp"
            android:letterSpacing="0.10"
            android:layout_marginTop="32dp" />

    </LinearLayout>

</ScrollView>