<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_destination_row"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/destinationImage"
        android:layout_width="104dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:contentDescription="Destination photograph"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/destinationNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="01 / ITALY"
                android:textColor="@color/sage"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↗"
                android:textColor="@color/forest_green"
                android:textSize="18sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/destinationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cinque Terre"
            android:textColor="@color/forest_green"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/destinationDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Coastal villages"
            android:textColor="@color/muted_text"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</LinearLayout>